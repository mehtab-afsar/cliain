generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Doctor {
  id            String         @id @default(cuid())
  clinicName    String?
  name          String
  specialty     String?
  whatsappPhone String?
  timezone      String         @default("UTC")
  googleCalendarId String?
  workingHours  WorkingHours[]
  appointments  Appointment[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  // Integration credentials — set from Settings → Integrations, encrypted at rest.
  // Falls back to env vars (see src/lib/env.ts) when unset, so an existing .env.local
  // deployment keeps working without visiting Settings.
  whatsappPhoneNumberId   String?
  whatsappAccessToken     String?
  whatsappVerifyToken     String?
  vapiApiKey              String?
  vapiPhoneNumberId       String?
  vapiToolWebhookUrl      String?
  googleServiceAccountJson String? @db.Text

  // Dashboard login — set during onboarding's last step, hashed (scrypt). Falls back to
  // DASHBOARD_PASSWORD env var when unset (see src/lib/session.ts).
  passwordHash String?
}

model WorkingHours {
  id        String  @id @default(cuid())
  doctorId  String
  doctor    Doctor  @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  dayOfWeek Int // 0 = Sunday .. 6 = Saturday
  isOpen    Boolean @default(true)
  startTime String // "09:00"
  endTime   String // "17:00"

  @@unique([doctorId, dayOfWeek])
}

model Patient {
  id            String         @id @default(cuid())
  name          String?
  phone         String         @unique
  createdAt     DateTime       @default(now())
  appointments  Appointment[]
  conversations Conversation[]
}

enum AppointmentStatus {
  booked
  cancelled
  completed
  no_show
}

model Appointment {
  id                     String            @id @default(cuid())
  doctorId               String
  doctor                 Doctor            @relation(fields: [doctorId], references: [id])
  patientId              String
  patient                Patient           @relation(fields: [patientId], references: [id])
  startAt                DateTime
  endAt                  DateTime
  status                 AppointmentStatus @default(booked)
  reason                 String?
  googleCalendarEventId  String?
  googleCalendarSyncError String?
  reminder24hSentAt      DateTime?
  reminder2hSentAt       DateTime?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  @@index([doctorId, startAt])
  @@index([patientId])
}

model Conversation {
  id        String   @id @default(cuid())
  patientId String
  patient   Patient  @relation(fields: [patientId], references: [id])
  role      String // "user" | "assistant"
  content   String   @db.Text
  wamid     String?  @unique
  createdAt DateTime @default(now())

  @@index([patientId, createdAt])
}
