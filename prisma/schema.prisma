generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String       @id @default(cuid())
  email       String       @unique
  name        String?
  image       String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  memberships Membership[]
}

enum MembershipRole {
  owner
  staff
}

model Membership {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  doctorId  String
  doctor    Doctor         @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  role      MembershipRole
  createdAt DateTime       @default(now())

  @@unique([userId, doctorId])
  @@index([doctorId])
}

model Invitation {
  id               String         @id @default(cuid())
  doctorId         String
  doctor           Doctor         @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  token            String         @unique
  role             MembershipRole @default(staff)
  createdByUserId  String
  expiresAt        DateTime
  acceptedAt       DateTime?
  acceptedByUserId String?
  createdAt        DateTime       @default(now())

  @@index([doctorId])
}

model Doctor {
  id            String         @id @default(cuid())
  clinicName    String?
  name          String
  specialty     String?
  whatsappPhone String?
  timezone      String         @default("UTC")
  googleCalendarId String?
  workingHours  WorkingHours[]
  appointments  Appointment[]
  patients      Patient[]
  memberships   Membership[]
  invitations   Invitation[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  // Integration credentials — set from Settings → Integrations, encrypted at rest.
  // Falls back to env vars (see src/lib/env.ts) when unset, so an existing .env.local
  // deployment keeps working without visiting Settings.
  whatsappPhoneNumberId   String?
  whatsappAccessToken     String?
  whatsappVerifyToken     String?
  vapiApiKey              String?
  vapiPhoneNumberId       String?
  vapiToolWebhookUrl      String?
  googleServiceAccountJson String? @db.Text
}

model WorkingHours {
  id        String  @id @default(cuid())
  doctorId  String
  doctor    Doctor  @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  dayOfWeek Int // 0 = Sunday .. 6 = Saturday
  isOpen    Boolean @default(true)
  startTime String // "09:00"
  endTime   String // "17:00"

  @@unique([doctorId, dayOfWeek])
}

model Patient {
  id            String         @id @default(cuid())
  doctorId      String
  doctor        Doctor         @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  name          String?
  phone         String
  createdAt     DateTime       @default(now())
  appointments  Appointment[]
  conversations Conversation[]

  @@unique([doctorId, phone])
}

enum AppointmentStatus {
  booked
  cancelled
  completed
  no_show
}

model Appointment {
  id                     String            @id @default(cuid())
  doctorId               String
  doctor                 Doctor            @relation(fields: [doctorId], references: [id])
  patientId              String
  patient                Patient           @relation(fields: [patientId], references: [id])
  startAt                DateTime
  endAt                  DateTime
  status                 AppointmentStatus @default(booked)
  reason                 String?
  googleCalendarEventId  String?
  googleCalendarSyncError String?
  reminder24hSentAt      DateTime?
  reminder2hSentAt       DateTime?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  @@index([doctorId, startAt])
  @@index([patientId])
}

model Conversation {
  id        String   @id @default(cuid())
  patientId String
  patient   Patient  @relation(fields: [patientId], references: [id])
  role      String // "user" | "assistant"
  content   String   @db.Text
  wamid     String?  @unique
  createdAt DateTime @default(now())

  @@index([patientId, createdAt])
}
