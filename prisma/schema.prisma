generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String       @id @default(cuid())
  email       String       @unique
  name        String?
  image       String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  memberships Membership[]
}

enum MembershipRole {
  owner
  staff
}

model Membership {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId  String
  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role      MembershipRole
  createdAt DateTime       @default(now())

  @@unique([userId, tenantId])
  @@index([tenantId])
}

model Invitation {
  id               String         @id @default(cuid())
  tenantId         String
  tenant           Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  token            String         @unique
  role             MembershipRole @default(staff)
  createdByUserId  String
  expiresAt        DateTime
  acceptedAt       DateTime?
  acceptedByUserId String?
  createdAt        DateTime       @default(now())

  @@index([tenantId])
}

// The tenant row — one per business account. Cliain 1.0 called this "Doctor" and modeled one
// clinic as one bookable person; generalized so a tenant can hold multiple locations and
// resources (see Location/Resource) without another migration. `vertical`/`templateVersion`
// select which template (see src/features/templates) supplies the AI's prompt content, safety
// rules, and default booking fields — clinic-only content that used to live inline in
// system-prompt.ts now lives in the "clinic-v1" template, and this row just points at it.
// `overrides` is tenant-specific config layered on top of the template's defaults (see
// config-resolver.ts) — validated against the template's own overridesSchema, not enforced by
// Postgres, same pattern ClinicSettings already used for its JSON document.
model Tenant {
  id         String  @id @default(cuid())
  clinicName String?
  // Business market and hosting region — unset for existing dev tenants until onboarding
  // (or a backfill) sets them; not yet read by any routing logic in this phase.
  market       String?
  regionCell   String?
  vertical     String @default("clinic")
  templateVersion String @default("clinic-v1")
  plan         String @default("trial")
  overrides    Json   @default("{}")
  whatsappPhone String?
  timezone      String         @default("UTC")
  // Defaults to "primary" the moment Google Calendar is connected (see the OAuth callback) —
  // editable afterward if the clinic wants bookings mirrored to a different calendar than
  // whichever Google account they connected. Also doubles as the "is Calendar sync on for
  // this booking" gate in appointment-service.ts.
  googleCalendarId String?
  locations     Location[]
  resources     Resource[]
  offerings     Offering[]
  sessions      Session[]
  bookings      Booking[]
  customers     Customer[]
  memberships   Membership[]
  invitations   Invitation[]
  settings      ClinicSettings?
  settingsAudit SettingsAudit[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  // Integration credentials — set from Settings → Integrations, encrypted at rest.
  // WhatsApp and Google Calendar: every clinic connects its own, there is no shared/fallback
  // credential (a shared fallback would leak one clinic's WhatsApp access to every other).
  // whatsappPhoneNumberId/vapiPhoneNumberId are unique so two clinics can't silently
  // collide on the same number — Postgres allows multiple NULLs, so unconfigured
  // clinics never conflict with each other.
  whatsappPhoneNumberId   String? @unique
  whatsappAccessToken     String?
  whatsappVerifyToken     String?
  // Meta's per-App signing secret — verifies inbound webhook deliveries actually came
  // from Meta (HMAC over the raw body, header `X-Hub-Signature-256`).
  whatsappAppSecret       String?
  // Phone calls: unlike WhatsApp/Calendar, this is Cliain-hosted — there's no per-clinic API
  // key. Cliain's own VAPI_API_KEY (env var, not stored here) provisions a number for the
  // clinic via vapi-provisioning.ts; these two columns just record what got provisioned.
  // vapiPhoneNumber is the human-readable E.164 number shown in Settings; vapiPhoneNumberId is
  // Vapi's own resource id, used to address it via their API.
  vapiPhoneNumberId       String? @unique
  vapiPhoneNumber         String?
  // Generated server-side at provisioning time, not typed by the clinic — echoed back by Vapi
  // as a header on every request, verifying it actually came from Vapi and not an outsider who
  // found the webhook URL.
  vapiWebhookSecret       String?
  // Google Calendar: a real "Connect with Google" OAuth flow (see
  // google-calendar-oauth.ts), not a service-account JSON paste — the clinic clicks a button,
  // sees Google's normal consent screen, and this refresh token is what lets Cliain mirror
  // bookings afterward without them staying signed in. googleCalendarAccountEmail is just
  // display metadata (which Google account is connected), not used for auth.
  googleCalendarRefreshToken String? @db.Text
  googleCalendarAccountEmail String?

  // Google Calendar push notifications (events.watch) — see calendar-watch-service.ts.
  // Channel/resource ids identify *this* watch registration so a renewal or stop can address
  // it; googleCalendarWatchChannelId is unique because the push-notification webhook route
  // receives only a channel id (no tenantId) and must look up the owning tenant by it.
  // googleCalendarSyncToken is Calendar's own cursor for incremental events.list reads,
  // rotated on every successful poll. googleCalendarWatchExpiresAt drives the renewal cron
  // (Google caps a channel at ~1 month) and googleCalendarWatchToken is compared against each
  // notification's X-Goog-Channel-Token header — Google's push notifications carry no HMAC,
  // so this shared secret (generated server-side, never shown to the clinic) is the only proof
  // a notification actually originated from a watch we registered.
  googleCalendarWatchChannelId  String?   @unique
  googleCalendarWatchResourceId String?
  googleCalendarWatchExpiresAt  DateTime?
  googleCalendarWatchToken      String?   @db.Text
  googleCalendarSyncToken       String?   @db.Text

  // Safety/escalation — see AGENT_TOOLS' "escalate" tool. escalationWhatsappNumber is who
  // gets alerted; emergencyScript is spoken/texted verbatim on a red-flag symptom (falls
  // back to a hardcoded default in code when unset).
  emergencyScript          String? @db.Text
  escalationWhatsappNumber String?

  // Billing (Stripe) — see src/lib/stripe.ts / src/features/billing. Platform-wide account
  // (this deployment's own Stripe account), unlike WhatsApp/Calendar which are per-tenant
  // credentials — these four columns just record what Stripe knows about this tenant.
  // `plan` (above) is the source of truth billing-gating logic reads; the webhook handler in
  // src/app/api/webhooks/stripe/route.ts is the only writer of these five fields together.
  // stripeCustomerId/stripeSubscriptionId are unique so two tenants can never point at the
  // same Stripe object; Postgres allows multiple NULLs, so tenants who never checked out
  // don't conflict with each other.
  stripeCustomerId         String?   @unique
  stripeSubscriptionId     String?   @unique
  // Stripe's own subscription.status ("active", "past_due", "canceled", "trialing", ...) —
  // kept verbatim (not remapped) so the webhook handler and any future admin view can trust
  // it matches Stripe's dashboard exactly; `plan` is the derived/simplified field app code
  // actually branches on.
  stripeSubscriptionStatus String?
  stripeCurrentPeriodEnd   DateTime?
}

// A branch. Every Cliain 1.0 tenant implicitly had exactly one (the clinic itself) — this
// model exists so a future multi-location tenant doesn't need another migration. Backfilled
// one-per-tenant; not yet surfaced in onboarding or settings UI.
model Location {
  id        String     @id @default(cuid())
  tenantId  String
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String?
  timezone  String
  address   String?
  isPrimary Boolean    @default(true)
  resources Resource[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

// Anything bookable: a doctor, a trainer, a table. Generalizes what Cliain 1.0 modeled as
// attributes directly on Doctor (name/title/specialty) — those fields moved here so a tenant
// can eventually have more than one. `type` is a free-form template-defined string (e.g.
// "practitioner" for clinic-v1) rather than a Postgres enum, validated at the application
// boundary by the template registry instead. `attributes` carries vertical-specific fields
// (specialty, gender, section, etc.) that don't deserve their own column.
model Resource {
  id           String         @id @default(cuid())
  tenantId     String
  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  locationId   String
  location     Location       @relation(fields: [locationId], references: [id], onDelete: Cascade)
  type         String
  name         String
  title        String?
  attributes   Json           @default("{}")
  workingHours WorkingHours[]
  bookings     Booking[]
  sessions     Session[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

// What customers book: a consultation, a class, a table. clinic-v1 only ever defines one
// ("Consultation") per tenant today, but this replaces the hardcoded SLOT_DURATION_MINUTES
// constant in availability-service.ts with a real per-tenant, per-offering value.
// `mode` decides which booking engine path applies (see availability-service.ts /
// appointment-service.ts): "appointment" is the existing one-resource-exclusive-per-slot path;
// "class" books against a capacity-limited Session instead. Branching on this in engine code is
// not a no-branching-rule violation — mode is a template-agnostic schema dimension shared by
// every vertical (a cafe needs "reservation" too), unlike Tenant.vertical itself.
model Offering {
  id              String      @id @default(cuid())
  tenantId        String
  tenant          Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name            String
  durationMinutes Int
  resourceType    String
  mode            BookingMode @default(appointment)
  // Seeded onto every Session created for this offering unless overridden per-session. Only
  // meaningful when mode = "class".
  defaultCapacity Int?
  fields          Json        @default("{}")
  active          Boolean     @default(true)
  bookings        Booking[]
  sessions        Session[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

enum SessionStatus {
  scheduled
  cancelled
}

// A generated class instance — "this Tuesday 6pm spin class, capacity 20." Only used by
// class-mode offerings; appointment-mode bookings have no Session. Created directly today
// (onboarding bulk-inserts a few weeks of rows from the chosen weekly slot) — there is no
// recurring-timetable generator yet (PRD module M9), so a class stops appearing once its
// bulk-created window runs out until that generator exists. See onboarding-repository.ts.
model Session {
  id         String        @id @default(cuid())
  tenantId   String
  tenant     Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  offeringId String
  offering   Offering      @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  resourceId String
  resource   Resource      @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  startAt    DateTime
  endAt      DateTime
  capacity   Int
  status     SessionStatus @default(scheduled)
  bookings   Booking[]
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([resourceId, startAt])
  @@index([tenantId, startAt])
}

// One versioned JSON document per tenant — the AI system prompt renders from this at request
// time (see resolveSettings() in settings-repository.ts), so changing a setting never needs a
// deploy. `data`'s shape is validated against the Zod schema in features/settings/schema.ts,
// not enforced by Postgres — schemaVersion exists so a future shape change can migrate old
// documents forward instead of silently misreading them.
model ClinicSettings {
  id            String   @id @default(cuid())
  tenantId      String   @unique
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  schemaVersion Int      @default(1)
  data          Json
  updatedAt     DateTime @updatedAt
}

// One row per settings write — who changed what, from what, to what, when. Shown at the
// bottom of each Settings tab.
model SettingsAudit {
  id       String   @id @default(cuid())
  tenantId String
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  field    String
  oldValue Json?
  newValue Json?
  actor    String
  at       DateTime @default(now())

  @@index([tenantId, at(sort: Desc)])
}

model WorkingHours {
  id         String   @id @default(cuid())
  resourceId String
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  dayOfWeek  Int // 0 = Sunday .. 6 = Saturday
  isOpen     Boolean  @default(true)
  startTime  String // "09:00"
  endTime    String // "17:00"

  @@unique([resourceId, dayOfWeek])
}

model Customer {
  id            String         @id @default(cuid())
  tenantId      String
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name          String?
  // Formalized as E.164 at the write boundary (see patient-service.ts) — already
  // WhatsApp-sourced in practice, just not validated before this phase.
  phone         String
  language      String?
  tags          String[]       @default([])
  fields        Json           @default("{}")
  createdAt     DateTime       @default(now())
  bookings      Booking[]
  conversations Conversation[]

  // Marketing/consent flags — replaces the single-purpose consentGivenAt (set the first time
  // the AI's disclosure line is sent on WhatsApp; see agent-loop.ts). Shape:
  // { whatsappDisclosure?: { grantedAt: string } }.
  consents Json @default("{}")

  // Set by the "escalate" tool (emergency, explicit human request, or the AI giving up after
  // ~2 attempts). While true, the AI does not reply — see runTool() in tools/index.ts and the
  // guard at the top of runAgentTurn. Cleared by staff from the Needs Attention dashboard page.
  needsHumanReview       Boolean   @default(false)
  needsHumanReviewReason String?
  needsHumanReviewAt     DateTime?

  @@unique([tenantId, phone])
}

enum BookingStatus {
  booked
  arrived
  in_progress
  completed
  cancelled
  no_show
  rescheduled
}

enum BookingMode {
  appointment
  class
  reservation
  request
}

model Booking {
  id                      String        @id @default(cuid())
  tenantId                String
  tenant                  Tenant        @relation(fields: [tenantId], references: [id])
  customerId              String
  customer                Customer      @relation(fields: [customerId], references: [id])
  resourceId              String
  resource                Resource      @relation(fields: [resourceId], references: [id])
  offeringId              String
  offering                Offering      @relation(fields: [offeringId], references: [id])
  // Only set for mode = "class" bookings — which Session this booking's partySize counts
  // against for capacity purposes (see writeIfCapacityAvailable in appointment-service.ts).
  sessionId               String?
  session                 Session?      @relation(fields: [sessionId], references: [id])
  mode                    BookingMode   @default(appointment)
  partySize               Int           @default(1)
  sourceChannel           String?
  fields                  Json          @default("{}")
  startAt                 DateTime
  endAt                   DateTime
  status                  BookingStatus @default(booked)
  // Free-text reason for the *current* status (cancellation reason, "auto: end of day", etc.)
  // — the full transition history lives in BookingEvent, this is just the latest one for
  // fast list/detail reads without a join.
  statusReason            String?
  reason                  String?
  // Set on the new row a reschedule creates; the old row is frozen at status "rescheduled"
  // rather than mutated in place, so both the original and the new time stay on record.
  rescheduledFromId       String?    @unique
  rescheduledFrom         Booking?   @relation("BookingReschedule", fields: [rescheduledFromId], references: [id])
  rescheduledTo           Booking?   @relation("BookingReschedule")
  completedAt             DateTime?
  completedBy             String?
  googleCalendarEventId   String?
  googleCalendarSyncError String?
  reminder24hSentAt       DateTime?
  reminder2hSentAt        DateTime?
  // Idempotency for tool-call retries (e.g. a replayed WhatsApp webhook) — derived from the
  // model's tool_use id so the same intended write can't create two bookings. Postgres allows
  // multiple NULLs in a unique index, so bookings created before this existed (or via paths
  // that don't pass one) never spuriously conflict with each other.
  idempotencyKey          String?
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt
  events                  BookingEvent[]

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, startAt])
  @@index([resourceId, startAt])
  @@index([sessionId])
  @@index([customerId])
}

// One row per status transition — an audit trail, not just the latest state. Written inside
// the same transaction as the status change it records, so there's no transition without a
// matching event.
model BookingEvent {
  id         String         @id @default(cuid())
  bookingId  String
  booking    Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  tenantId   String
  at         DateTime       @default(now())
  fromStatus BookingStatus?
  toStatus   BookingStatus
  actor      String // 'ai' | 'scheduler' | 'staff:<userId>'
  channel    String? // 'whatsapp' | 'voice' | 'dashboard' | null
  reason     String?

  @@index([tenantId, at(sort: Desc)])
}

model Conversation {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  role       String // "user" | "assistant"
  content    String   @db.Text
  wamid      String?  @unique
  createdAt  DateTime @default(now())

  @@index([customerId, createdAt])
}

// The usage/billing ledger — one row per billable unit (an LLM call today; WhatsApp messages,
// voice minutes, STT/TTS seconds in later phases). Populated by the model router
// (src/lib/model-router) from each provider's own usage response plus a static price table.
// No real billing integration reads this yet in this phase — it exists so the shape and the
// write path are in place before usage needs to be metered for real.
model UsageEvent {
  id             BigInt   @id @default(autoincrement())
  tenantId       String
  kind           String // 'llm_call', later: 'wa_msg_utility', 'voice_min_cascaded', etc.
  provider       String?
  model          String?
  inputTokens    Int?
  outputTokens   Int?
  costUsdMicros  BigInt?
  channel        String?
  conversationId String?
  bookingId      String?
  createdAt      DateTime @default(now())

  @@index([tenantId, createdAt])
}
