# Postgres connection string. Local dev default (see README for setup):
DATABASE_URL="postgresql://localhost:5432/cliain_dev?schema=public"

# Anthropic API key — required for the AI booking agent (app/api/ai/chat, WhatsApp webhook).
ANTHROPIC_API_KEY=

# Gates /dashboard/* and its sensitive APIs (Settings, Appointments, Patients) behind a single
# shared password — see /login. Without both of these set, the dashboard just redirects to a
# "login isn't set up" message and stays inaccessible; the public landing/onboarding pages are
# unaffected. Generate SESSION_SECRET with `openssl rand -base64 32`.
DASHBOARD_PASSWORD=
SESSION_SECRET=

# Encrypts WhatsApp/Vapi/Google Calendar credentials saved from Settings → Integrations before
# they're stored in Postgres. Generate one with `openssl rand -base64 32`. Only needed if you
# use that UI — the env vars below still work standalone without it.
INTEGRATION_ENCRYPTION_KEY=

# WhatsApp Cloud API (Meta) — can be set here OR from Settings → Integrations in the dashboard.
# Get these from developers.facebook.com after creating a Meta App with the WhatsApp product.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Any secret string you choose — Meta echoes it back during webhook verification.
WHATSAPP_VERIFY_TOKEN=

# Google Calendar sync — can be set here OR from Settings → Integrations in the dashboard.
# A Service Account JSON key (see README). Paste the whole JSON as one line, or point to a
# file path instead by using GOOGLE_SERVICE_ACCOUNT_FILE.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_FILE=

# Vapi (voice AI) — can be set here OR from Settings → Integrations in the dashboard. Get
# VAPI_API_KEY and VAPI_PHONE_NUMBER_ID from vapi.ai. VAPI_TOOL_WEBHOOK_URL must be a publicly
# reachable URL pointing at /api/webhooks/vapi (use ngrok/cloudflared locally, same as WhatsApp).
VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=
VAPI_TOOL_WEBHOOK_URL=
