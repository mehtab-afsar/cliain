# Postgres connection string. Local dev default (see README for setup):
DATABASE_URL="postgresql://localhost:5432/cliain_dev?schema=public"

# Anthropic API key — required for the AI booking agent (app/api/ai/chat, WhatsApp webhook).
ANTHROPIC_API_KEY=

# OpenAI failover for the model router — only called when Anthropic fails or its circuit is
# open. The agent works fine without this set; it just has no failover.
OPENAI_API_KEY=

# Sign in with Google (Auth.js). Create an OAuth client in Google Cloud Console
# (type "Web application"); authorized redirect URI is
# <origin>/api/auth/callback/google for each environment (localhost + deployed).
# Generate AUTH_SECRET with `openssl rand -base64 32`.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_SECRET=

# Signs the short-lived tool session tokens the Tool Gateway mints after a WhatsApp/Vapi
# webhook's own signature check succeeds — the thing that actually binds a tool call to a
# tenant. Its own secret, not reused from AUTH_SECRET or INTEGRATION_ENCRYPTION_KEY. Generate
# with `openssl rand -base64 32`.
TOOL_TOKEN_SECRET=

# Beta bypass (see src/lib/session.ts) — set to "true" to skip Google sign-in entirely.
# Every visitor becomes the same shared "Beta Tester" account with full dashboard access —
# this isn't just "skip login for me," it removes login for everyone who reaches this
# deployment. Fine for local dev or a private beta link; unset before anyone outside the
# team can reach the URL. Real Google sign-in still works normally when this is unset.
BYPASS_AUTH=

# Encrypts each clinic's WhatsApp/Google Calendar credentials, and Cliain's own generated
# per-clinic Vapi webhook secrets, before they're stored in Postgres. Generate with
# `openssl rand -base64 32`.
INTEGRATION_ENCRYPTION_KEY=

# This deployment's own base URL — used for the WhatsApp webhook URL and the Google Calendar
# OAuth callback. Both are browser-mediated (Calendar) or pasted into a dashboard yourself
# (WhatsApp), so a plain localhost URL is fine here even in dev — don't point this at a tunnel,
# see VAPI_PUBLIC_URL below for the one thing that actually needs one. No trailing slash.
APP_URL=

# Bearer token required to trigger /api/cron/reminders from an external scheduler (e.g.
# Vercel Cron) — only needed if you're not using the in-process node-cron scheduler
# (instrumentation.ts), which doesn't touch this endpoint. Generate with `openssl rand -base64 32`.
CRON_SECRET=

# Cliain's own Vapi account (see src/features/ai-agent/services/vapi-provisioning.ts) — NOT
# per-clinic. A clinic clicks "Enable phone calls" in Settings → Integrations and a phone
# number gets provisioned on this one key; no clinic ever sees or holds a Vapi credential of
# their own. Get this from vapi.ai → Dashboard → API Keys. Leave empty to keep phone calls
# unavailable on this deployment.
VAPI_API_KEY=

# Where VAPI'S SERVERS reach back into this app — genuinely different from APP_URL, because
# Vapi needs a URL reachable from the public internet even in local dev (a real tunnel like
# ngrok/cloudflared), while APP_URL can stay plain localhost. Falls back to APP_URL if unset,
# so a real deployment (one real public domain for everything) never needs to set this
# separately — only local dev testing a live call does.
VAPI_PUBLIC_URL=

# Where GOOGLE'S SERVERS reach back into this app for Calendar push notifications
# (events.watch) — same "must be a real public HTTPS URL, not localhost" constraint as
# VAPI_PUBLIC_URL above (both can share one cloudflared/ngrok tunnel, just two env vars
# pointed at it). Falls back to APP_URL if unset. Optional: without a reachable URL here,
# Google Calendar connections still work for booking (the one-way write mirror + freebusy
# read-back), just without instant sync when a doctor edits an appointment directly in their
# own Google Calendar — the next 5-minute reminder-cron tick's freebusy check still catches
# most of that.
GOOGLE_CALENDAR_WEBHOOK_URL=

# WhatsApp and Google Calendar credentials are per-clinic — connect each from Settings →
# Integrations in the dashboard, not here. Each clinic gets its own webhook URL to paste
# into their own Meta App (shown right there in Settings).

# Rate limits the public webhook routes (src/lib/rate-limit.ts) — required on serverless
# hosting (e.g. Vercel), where there's no shared memory between invocations for an in-process
# limiter. Create a free database at upstash.com and copy its REST URL/token. Optional: rate
# limiting just fails open (disabled) if these aren't set.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Error monitoring (sentry.server.config.ts / sentry.edge.config.ts) — create a free project
# at sentry.io and copy its DSN. Optional: no-ops without this set.
SENTRY_DSN=

# Build-time only (next.config.ts) — uploads source maps to Sentry so stack traces are
# readable. Optional: the build succeeds without these, just without source maps.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Set to "true" temporarily to log the raw Vapi webhook payload — use for one real test call
# to confirm the payload shape assumed in src/app/api/webhooks/vapi/[doctorId]/route.ts, then
# unset it again. Off by default.
DEBUG_VAPI_WEBHOOK=

# Billing (Stripe) — this deployment's OWN account, platform-wide, not per-clinic (unlike
# WhatsApp/Calendar above). No Stripe account exists yet as of this phase; leaving all three
# empty is fully supported — see getStripeConfig() in src/lib/stripe.ts — the Billing tab and
# checkout/webhook routes just report "billing isn't configured yet" instead of crashing.
#
# Secret key from the Stripe Dashboard → Developers → API keys ("Secret key", starts with
# "sk_"). Use a test-mode key until you're ready to charge real cards.
STRIPE_SECRET_KEY=

# Signing secret for the /api/webhooks/stripe endpoint — Dashboard → Developers → Webhooks →
# your endpoint → "Signing secret" (starts with "whsec_"). Verifies a delivery really came
# from Stripe before it's trusted to change a tenant's plan.
STRIPE_WEBHOOK_SECRET=

# PLACEHOLDER — not yet confirmed by the founder. The Price id (starts with "price_") for the
# recurring monthly "Pro" plan price, created in the Stripe Dashboard (Products → add a
# product → add a recurring price). This scaffolding proposes $49/mo as a starting number for
# an AI-reception SaaS aimed at small clinics/gyms (see the comment on getStripeConfig() in
# src/lib/stripe.ts) — confirm the real price before creating the live Price object and
# pasting its id here.
STRIPE_PRICE_ID_PRO=
