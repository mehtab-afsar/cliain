# Postgres connection string. Local dev default (see README for setup):
DATABASE_URL="postgresql://localhost:5432/cliain_dev?schema=public"

# Anthropic API key — required for the AI booking agent (app/api/ai/chat, WhatsApp webhook).
ANTHROPIC_API_KEY=

# Sign in with Google (Auth.js). Create an OAuth client in Google Cloud Console
# (type "Web application"); authorized redirect URI is
# <origin>/api/auth/callback/google for each environment (localhost + deployed).
# Generate AUTH_SECRET with `openssl rand -base64 32`.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_SECRET=

# Encrypts each clinic's WhatsApp/Vapi/Google Calendar credentials before they're stored in
# Postgres — every clinic connects its own from Settings → Integrations, there is no shared
# fallback. Generate with `openssl rand -base64 32`.
INTEGRATION_ENCRYPTION_KEY=

# This deployment's public base URL — used to build each clinic's Vapi tool webhook URL
# (<APP_URL>/api/webhooks/vapi/<doctorId>). Required for Vapi to work at all. No trailing
# slash. In dev, this is your ngrok/cloudflared tunnel URL.
APP_URL=

# Bearer token required to trigger /api/cron/reminders from an external scheduler (e.g.
# Vercel Cron) — only needed if you're not using the in-process node-cron scheduler
# (instrumentation.ts), which doesn't touch this endpoint. Generate with `openssl rand -base64 32`.
CRON_SECRET=

# WhatsApp and Vapi credentials are per-clinic now — connect each from Settings →
# Integrations in the dashboard, not here. Each clinic gets its own webhook URL to paste
# into their own Meta App / Vapi assistant (shown right there in Settings).
