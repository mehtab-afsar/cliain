# Postgres connection string. Local dev default (see README for setup):
DATABASE_URL="postgresql://localhost:5432/cliain_dev?schema=public"

# Anthropic API key — required for the AI booking agent (app/api/ai/chat, WhatsApp webhook).
ANTHROPIC_API_KEY=

# WhatsApp Cloud API (Meta) — required for the WhatsApp webhook to send/receive real messages.
# Get these from developers.facebook.com after creating a Meta App with the WhatsApp product.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Any secret string you choose — Meta echoes it back during webhook verification.
WHATSAPP_VERIFY_TOKEN=

# Google Calendar sync — a Service Account JSON key (see README). Paste the whole JSON as one line,
# or point to a file path instead by using GOOGLE_SERVICE_ACCOUNT_FILE.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_FILE=

# Vapi (voice AI) — required for outbound reminder/confirmation calls. Get VAPI_API_KEY and
# VAPI_PHONE_NUMBER_ID from vapi.ai. VAPI_TOOL_WEBHOOK_URL must be a publicly reachable URL
# pointing at /api/webhooks/vapi (use ngrok/cloudflared locally, same as the WhatsApp webhook).
VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=
VAPI_TOOL_WEBHOOK_URL=
